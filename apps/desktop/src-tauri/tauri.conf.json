{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linka",
  "version": "0.3.0",
  "identifier": "app.linka.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../web run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [{
      "title": "Linka",
      "width": 1120,
      "height": 780,
      "minWidth": 760,
      "minHeight": 560,
      "center": true,
      "visible": false
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: blob:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "A private local-first inbox",
    "longDescription": "Save, search and organise links, thoughts and text locally."
  }
}