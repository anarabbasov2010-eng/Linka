{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linka",
  "version": "0.3.2",
  "identifier": "app.linka.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../web run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Linka",
        "width": 1120,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob: https://videos.pexels.com https://d2ol7oe51mr4n9.cloudfront.net; connect-src 'self' https://api.github.com https://*.supabase.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "A private local-first inbox",
    "longDescription": "Save, search and organise links, thoughts and text locally.",
    "createUpdaterArtifacts": false,
    "fileAssociations": [
      {
        "ext": [
          "linka"
        ],
        "name": "Linka document",
        "description": "Linka text document",
        "mimeType": "application/vnd.linka.document+json",
        "role": "Editor",
        "exportedType": {
          "identifier": "app.linka.document",
          "conformsTo": [
            "public.data",
            "public.json",
            "public.plain-text"
          ]
        }
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "Russian"
        ],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "startMenuFolder": "Linka"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "linka"
        ]
      }
    }
  }
}
